# ===== 服务 =====
# 后端监听端口，默认 3000
PORT=3000

# ===== 微信公众平台（服务端用：jscode2session 换 openid / wxacode 生成小程序码） =====
# 不配置：降级为本机随机 dev_id 身份，小程序码降级为文本码，其余流程照常
WX_APPID=
WX_SECRET=

# ===== 管理员 =====
# 管理员 openid 白名单，逗号分隔；管理端接口按此鉴权，非白名单返回 403
ADMIN_OPENIDS=
# 管理员码内嵌防伪 key
ADMIN_QR_KEY=

# ===== 阿里云智能语音交互 NLS（方言 ASR / TTS） =====
# 默认 appkey；方言按 appkey 绑定模型，可另配 NLS_APPKEY_<方言> 覆盖
# 不配置：答题识别降级为桩，朗读降级为前端兜底
NLS_APPKEY=
ALI_AK_ID=
ALI_AK_SECRET=

# ===== LLM（OpenAI 兼容协议；剧本生成 / 判分 / 追问 / 答疑） =====
# 主通道（缺省即 DeepSeek：https://api.deepseek.com + deepseek-chat）
LLM_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 备用通道 2 / 3：主通道失败时按序降级；不配置则只用主通道
LLM_KEY_2=
LLM_BASE_URL_2=
LLM_MODEL_2=
LLM_KEY_3=
LLM_BASE_URL_3=
LLM_MODEL_3=
# 三通道全不可用：回落预置剧本与规则判分，不断链

# ===== 和风天气（可选：气象风险感知） =====
# 不配置：/api/weather 返回演示天气并标注 source:"stub"
QWEATHER_KEY=
# 新版控制台分配的专属 API Host（如 xxxx.re.qweatherapi.com）；经典老 key 留空即可
QWEATHER_HOST=

# ===== 部署脚本用（server/deploy/*.py，本地环境注入，服务端运行不需要） =====
SSHPASS=
