page {
  height: 100%;
  overflow: hidden;      /* 页面本身不许滚，滚动只发生在字幕窗内 */
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ================= 品牌启动页 ================= */
.splash {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 99;
  background: var(--c-primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: opacity .45s ease-out;
}
.splash.out { opacity: 0; }
.logo-badge {
  width: 168rpx;
  height: 168rpx;
  border-radius: 36rpx;
  background: #fff;
  color: var(--c-primary);
  font-size: 64rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,.18);
}
.app-name {
  margin-top: 36rpx;
  color: #fff;
  font-size: 56rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}
.slogan {
  margin-top: 16rpx;
  color: rgba(255,255,255,.85);
  font-size: 34rpx;
  letter-spacing: 8rpx;
}
.splash-tip {
  position: absolute;
  bottom: 120rpx;
  color: rgba(255,255,255,.7);
  font-size: var(--fs-sub);
}

/* ================= 顶部进度区 ================= */
.topbar {
  padding: 20rpx 32rpx 16rpx;
  background: var(--c-bg);
}
.stage {
  font-size: var(--fs-sub);
  font-weight: bold;
  color: var(--c-primary);
  margin-bottom: 12rpx;
  text-align: center;
}
.progress-track {
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--c-line);
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--c-primary);
  transition: width .4s ease-out;
}

/* ================= 字幕流（三级灰度） ================= */
.lyric {
  flex: 1;
  min-height: 0;         /* 关键：允许压缩到内容高度以下，否则字幕把页面顶出屏外 */
}
.line {
  padding: 30rpx 48rpx;
  text-align: center;
  transition: color .3s, transform .3s, opacity .3s;
}
.line.on {
  color: var(--c-primary-d);
  font-weight: bold;
  transform: scale(1.05);   /* transform 不占布局，行高稳定 */
}
.line.near { color: #6A7180; }   /* 相邻行：可读 */
.line.far  { color: #B9BEC9; }   /* 远处行：淡出 */

/* 字号三档：l=36 / xl=46 / xxl=56，由档案 font_size 决定，只大不小 */
.fs-l   { font-size: 36rpx; }
.fs-xl  { font-size: 46rpx; }
.fs-xxl { font-size: 56rpx; }

/* ================= 遮罩层 ================= */
.loading {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 9;
  background: var(--c-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-ink-3);
  font-size: var(--fs-sub);
}

.pause-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 8;
  background: rgba(245,246,248,.78);   /* 字幕压暗 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: fade-in .2s;
}
.pause-triangle {
  width: 0;
  height: 0;
  border-left: 72rpx solid var(--c-primary);
  border-top: 46rpx solid transparent;
  border-bottom: 46rpx solid transparent;
  margin-left: 20rpx;   /* 视觉居中补偿 */
}
.pause-tip {
  margin-top: 32rpx;
  color: var(--c-primary);
  font-size: var(--fs-sub);
  font-weight: bold;
}

.cmd-dot {
  position: fixed;
  top: 24rpx;
  right: 28rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--c-red);
  animation: pulse 1.2s infinite;
  z-index: 7;
}

/* ================= 底部操作区 ================= */
.dock {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  min-height: 280rpx;
}

/* 打断提问按钮：读正文时悬浮在圆钮左侧，戴手套也够得着 */
.askq {
  position: absolute;
  left: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: var(--c-card);
  border: 3rpx solid var(--c-primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card);
}
.askq:active { opacity: .85; }
.askq-icon {
  color: var(--c-primary);
  font-size: 52rpx;
  font-weight: bold;
  line-height: 1.1;
}
.askq-text {
  color: var(--c-primary);
  font-size: 24rpx;
}

.btn-round {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  transition: transform .15s, opacity .15s;
}
.btn-round:active { transform: scale(.96); }
.btn-round.on   { background: var(--c-red); }
.btn-round.off  { background: var(--c-green); }

/* 读题提示 */
.ask-panel {
  display: flex;
  align-items: center;
  background: var(--c-card);
  border-radius: 999rpx;
  padding: 28rpx 48rpx;
  box-shadow: var(--shadow-card);
}
.ask-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--c-primary);
  margin-right: 16rpx;
  animation: sk-breathe 1s infinite;
}
.ask-text {
  color: var(--c-ink-2);
  font-size: var(--fs-sub);
}

/* 录音面板：全屏最强视觉（红底 + 声波 + 秒数） */
.rec-panel {
  width: 100%;
  border-radius: 28rpx;
  background: var(--c-red);
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: pop-in .25s ease-out;
}
.rec-panel.idle { background: var(--c-ink-3); }
.rec-text {
  margin-top: 20rpx;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}
.rec-done {
  margin-top: 24rpx;
  background: #fff;
  color: var(--c-red);
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 999rpx;
  padding: 16rpx 64rpx;
}
.rec-done:active { opacity: .85; }
