page {
  background: var(--c-bg);
}

.page {
  padding: 24rpx 24rpx 180rpx;   /* 底部留给添加按钮 */
  min-height: 100vh;
  box-sizing: border-box;
}

/* 检索栏 */
.searchbar {
  display: flex;
  align-items: center;
  background: var(--c-card);
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  margin-bottom: 8rpx;
  box-shadow: var(--shadow-card);
}
.search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid var(--c-ink-3);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}
.search-icon::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 4rpx;
  background: var(--c-ink-3);
  right: -12rpx;
  bottom: -6rpx;
  transform: rotate(45deg);
  border-radius: 2rpx;
}
.search-input {
  flex: 1;
  margin-left: 20rpx;
  font-size: var(--fs-sub);
  color: var(--c-ink);
}

/* 日期分隔 */
.date-divider {
  margin: 28rpx 8rpx 16rpx;
  font-size: var(--fs-sub);
  font-weight: bold;
  color: var(--c-ink-3);
}

/* 推送记录卡 */
.rec-card {
  background: var(--c-card);
  border-radius: var(--r-card);
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-card);
}
.rec-card:active { opacity: .85; }
.rec-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.rec-title {
  flex: 1;
  font-size: var(--fs-title);
  font-weight: bold;
  color: var(--c-ink);
  line-height: 1.35;
}
.c-arrow {
  font-size: 44rpx;
  color: var(--c-ink-3);
  margin-left: 12rpx;
}
.rec-tags {
  display: flex;
  margin-top: 16rpx;
}
.rec-tags .badge { margin-right: 12rpx; }
.rec-note {
  margin-top: 14rpx;
  font-size: var(--fs-sub);
  color: var(--c-ink-2);
  line-height: 1.5;
}
.rec-foot {
  margin-top: 14rpx;
  font-size: var(--fs-caption);
  color: var(--c-ink-3);
}

/* 底部添加按钮（固定） */
.add-wrap {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--c-bg) 70%, rgba(245,246,248,0));
}
.add-btn {
  box-shadow: 0 8rpx 24rpx rgba(27,75,143,.25);
}

/* 详情半屏 */
.sheet-title {
  font-size: var(--fs-title);
  font-weight: bold;
  color: var(--c-ink);
}
.sheet-tags { margin: 16rpx 0 4rpx; }
.sheet-note { margin-top: 12rpx; }
.d-sec {
  margin: 28rpx 0 12rpx;
  font-size: var(--fs-sub);
  font-weight: bold;
  color: var(--c-primary);
  border-left: 8rpx solid var(--c-primary);
  padding-left: 16rpx;
}
.d-kb {
  background: #EEF1F5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}
.d-kb-head {
  font-size: var(--fs-sub);
  font-weight: bold;
  color: var(--c-ink);
}
.d-kb-doc {
  margin-left: 8rpx;
  font-size: var(--fs-caption);
  font-weight: normal;
  color: var(--c-primary);
}
.d-kb-sum {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  color: var(--c-ink-2);
  line-height: 1.5;
}
.d-loading {
  padding: 24rpx 8rpx;
  font-size: var(--fs-sub);
  color: var(--c-ink-3);
}
.sheet-cancel { margin-top: 32rpx; }
