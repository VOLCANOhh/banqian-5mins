<view class="page">
  <!-- 机制1入口：工人亮身份码，班组长扫认领 -->
  <view class="bind-entry">
    <view class="be-btn primary" bindtap="scanClaim">扫工人身份码绑定</view>
  </view>

  <!-- 分组列表 -->
  <block wx:for="{{groups}}" wx:key="group_id">
    <view class="gcard">
      <view class="ghead" bindtap="toggleGroup" data-gid="{{item.group_id}}">
        <view class="gname">{{item.name}}</view>
        <view class="gcount">{{item.count}} 人</view>
        <view class="garrow {{expanded === item.group_id ? 'up' : ''}}">›</view>
      </view>
      <block wx:if="{{expanded === item.group_id}}">
        <view class="wrow" wx:for="{{item.workers}}" wx:for-item="w" wx:key="worker_id" bindtap="edit" data-w="{{w}}">
          <view class="wmain">
            <view class="wname">{{w.name}}<text class="tag-job {{w._cls}}">{{w.job}}</text></view>
            <view class="wsub">{{w.age}} 岁 · 工龄 {{w.years}} 年<block wx:if="{{w.phone_masked}}"> · {{w.phone_masked}}</block></view>
          </view>
          <view class="badge badge-blue">字幕 {{w.font_size}}</view>
        </view>
        <view class="add-in-group" bindtap="addInGroup" data-gid="{{item.group_id}}">＋ 添加该组工人</view>
      </block>
    </view>
  </block>

  <view class="btn btn-primary add-btn" bindtap="openAddGroup">＋ 添加分组</view>

  <!-- 添加分组半屏 -->
  <view wx:if="{{showAddGroup}}" class="half-mask" bindtap="closeAddGroup">
    <view class="half-sheet" catchtap="noop">
      <view class="sheet-title">添加分组</view>
      <view class="label">组名</view>
      <input class="field" value="{{groupName}}" bindinput="onGroupNameInput" placeholder="例如：三班 / 水电组" maxlength="12" />
      <view class="btn btn-primary sheet-btn" bindtap="saveGroup">保存</view>
      <view class="btn btn-ghost sheet-cancel" bindtap="closeAddGroup">取消</view>
    </view>
  </view>

  <!-- 添加/编辑工人半屏（医院小程序式规范表单） -->
  <view wx:if="{{editing}}" class="half-mask" bindtap="cancel">
    <view class="half-sheet" catchtap="noop">
      <view class="sheet-title">{{editing.worker_id ? '编辑工人' : '添加工人'}}</view>

      <view class="form-sec">基本信息</view>
      <view class="label">姓名 <text class="req">*</text></view>
      <input class="field {{errors.name ? 'err' : ''}}" data-k="name" value="{{editing.name}}" bindinput="onInput" placeholder="工人姓名" maxlength="20" />
      <view class="err-text" wx:if="{{errors.name}}">{{errors.name}}</view>

      <view class="label">年龄 <text class="req">*</text></view>
      <input class="field {{errors.age ? 'err' : ''}}" type="number" data-k="age" value="{{editing.age}}" bindinput="onInput" placeholder="岁（决定字幕字号，≥50 岁最大档）" />
      <view class="err-text" wx:if="{{errors.age}}">{{errors.age}}</view>

      <view class="label">工种</view>
      <picker range="{{jobs}}" value="{{jobIndex}}" bindchange="onJob">
        <view class="field picker">{{editing.job || '请选择工种'}}</view>
      </picker>

      <view class="label">习惯语言</view>
      <picker range="{{dialects}}" value="{{dialectIndex}}" bindchange="onDialect">
        <view class="field picker">{{editing.dialect || '普通话'}}</view>
      </picker>
      <view class="label-sub">语音识别按此选择方言模型，工人说话听不懂时优先改这里</view>

      <view class="label">工龄</view>
      <input class="field" type="number" data-k="years" value="{{editing.years}}" bindinput="onInput" placeholder="年" />

      <view class="form-sec">联系方式（选填）</view>
      <view class="label">手机号</view>
      <input class="field {{errors.phone ? 'err' : ''}}" type="number" value="{{phoneDisplay}}" bindinput="onPhoneInput"
             placeholder="{{editing.worker_id ? '留空则不修改' : '用于学习提醒，列表中脱敏显示'}}" maxlength="13" />
      <view class="err-text" wx:if="{{errors.phone}}">{{errors.phone}}</view>

      <!-- 隐私声明：报告伦理承诺落到 UI -->
      <view class="privacy">工人信息仅用于安全培训与学习档案，不作为绩效考核或处罚依据；手机号等敏感信息在列表中脱敏显示。</view>

      <!-- 绑定码卡（保存成功后显示）：官方码图优先，降级文本码（画到屏外画布再转图片显示） -->
      <view class="bind-card" wx:if="{{bind}}">
        <image wx:if="{{bind.wxacode_img}}" class="bind-qrc" src="{{bind.wxacode_img}}" mode="aspectFit"/>
        <image wx:elif="{{bind.qr_img}}" class="bind-qrc" src="{{bind.qr_img}}" mode="aspectFit"/>
        <canvas wx:else canvas-id="bindQr" class="bind-qrc-off"></canvas>
        <view class="bind-text">
          <view class="bind-title">专属绑定码已生成</view>
          <view class="bind-sub">让工人扫这个码即可绑定；码面防伪 key 可随时在工人详情页重发作废</view>
        </view>
      </view>

      <view class="btn btn-primary" bindtap="save">保存</view>
      <view class="btn btn-ghost sheet-cancel" bindtap="cancel">返回</view>
    </view>
  </view>

  <!-- 认领半屏：扫到身份码 → 选已有工友或新建 -->
  <view wx:if="{{claim}}" class="half-mask" bindtap="closeClaim">
    <view class="half-sheet" catchtap="noop">
      <view class="sheet-title">绑定工人身份码 {{claim.ticket}}</view>
      <view class="label">这位工友是谁？</view>
      <scroll-view scroll-y class="pick-list">
        <view wx:for="{{all}}" wx:key="worker_id"
              class="pick-row {{claimSel === item.worker_id ? 'on' : ''}}"
              bindtap="pickWorker" data-id="{{item.worker_id}}">
          <view class="wname">{{item.name}}<text class="tag-job {{item._cls}}">{{item.job}}</text></view>
          <view class="wsub">{{item.group_name}} · {{item.age}} 岁</view>
        </view>
        <view class="pick-row new {{claimNew ? 'on' : ''}}" bindtap="pickNew">＋ 是新工人，现场建档</view>
      </scroll-view>

      <!-- 新建模式：最小表单 -->
      <block wx:if="{{claimNew}}">
        <view class="form-sec">新工人档案</view>
        <view class="label">姓名 <text class="req">*</text></view>
        <input class="field {{claimErrors.name ? 'err' : ''}}" data-k="name" value="{{newWorker.name}}" bindinput="onNewInput" placeholder="工人姓名" maxlength="20" />
        <view class="label">年龄 <text class="req">*</text></view>
        <input class="field {{claimErrors.age ? 'err' : ''}}" type="number" data-k="age" value="{{newWorker.age}}" bindinput="onNewInput" placeholder="岁（决定字幕字号）" />
        <view class="label">工种</view>
        <picker range="{{jobs}}" value="{{newJobIndex}}" bindchange="onNewJob">
          <view class="field picker">{{newWorker.job || '请选择工种'}}</view>
        </picker>
        <view class="label">习惯语言</view>
        <picker range="{{dialects}}" value="{{newDialectIndex}}" bindchange="onNewDialect">
          <view class="field picker">{{newWorker.dialect || '普通话'}}</view>
        </picker>
        <view class="label">分组 <text class="req">*</text></view>
        <picker range="{{groups}}" range-key="name" value="{{newGroupIndex}}" bindchange="onNewGroup">
          <view class="field picker {{claimErrors.group_id ? 'err' : ''}}">{{groups[newGroupIndex] ? groups[newGroupIndex].name : '请选择分组'}}</view>
        </picker>
      </block>

      <view class="btn btn-primary" bindtap="claimSubmit">确认绑定</view>
      <view class="btn btn-ghost sheet-cancel" bindtap="closeClaim">取消</view>
    </view>
  </view>

</view>
